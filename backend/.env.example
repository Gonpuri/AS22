# Copiar a .env y completar. En Render se definen como variables de entorno.
DJANGO_SECRET_KEY=cambiar-por-un-valor-secreto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL de Render (Internal/External Database URL). Si no se define, se usa SQLite local.
DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Origen del frontend desplegado en Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173
